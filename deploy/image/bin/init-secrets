#!/bin/bash
# Creates the database passwords once. The superuser password goes to its own
# volume that only the database mounts; the passwords of the two module roles go
# to the secrets volume that the server reads. A later start keeps the passwords
# that already exist.
set -euo pipefail

dir="${L2JFREE_SECRETS_DIR:-/var/lib/l2jfree/secrets}"
db_dir="${L2JFREE_DB_SECRETS_DIR:-/var/lib/l2jfree/secrets-db}"
umask 022

# Writes a new password to a temporary file and renames it, so an interrupted
# run never leaves an empty or half-written secret behind.
make_secret() {
	local file="$1/$2"
	if [ ! -s "$file" ]; then
		head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32 > "$file.tmp"
		mv "$file.tmp" "$file"
		echo "init-secrets: created $2"
	else
		echo "init-secrets: $2 already exists"
	fi
}

make_secret "$db_dir" postgres_password
make_secret "$dir" login_password
make_secret "$dir" world_password
