#!/bin/bash
# Creates the database password once, in the secrets volume. A later start
# keeps the password that already exists.
set -euo pipefail

dir="${L2JFREE_SECRETS_DIR:-/var/lib/l2jfree/secrets}"
file="$dir/db_password"

if [ ! -s "$file" ]; then
	umask 022
	head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32 > "$file"
	echo "init-secrets: created the database password"
else
	echo "init-secrets: the database password already exists"
fi
