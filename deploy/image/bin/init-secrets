#!/bin/bash
# Creates the database passwords once, in the secrets volume. A later start
# keeps the passwords that already exist.
set -euo pipefail

dir="${L2JFREE_SECRETS_DIR:-/var/lib/l2jfree/secrets}"
umask 022

make_secret() {
	local file="$dir/$1"
	if [ ! -s "$file" ]; then
		head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32 > "$file"
		echo "init-secrets: created $1"
	else
		echo "init-secrets: $1 already exists"
	fi
}

make_secret postgres_password
make_secret login_password
make_secret world_password
